# Copy this file to .env and fill in your IP Australia API credentials.
# Register for free at https://portal.api.ipaustralia.gov.au/
# (subscribe to the "Australian Trade Mark Search API")

IPA_CLIENT_ID=
IPA_CLIENT_SECRET=

# "production" or "test" (IP Australia's sandbox). Default: production
IPA_ENV=production

# Port for the local web server. Default: 3000
PORT=3000

# Max trade-mark detail lookups per search (each result needs one API call).
# Lower this if you hit rate limits. Default: 60
MAX_DETAIL_LOOKUPS=60
